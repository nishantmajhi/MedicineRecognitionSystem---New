<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to open the viewfinder. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The app is usable without a camera via the gallery picker, so the
         camera is declared optional; marking it required would hide the app
         from tablets that lack a rear camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="SwetSandhya"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Development only: the backend is served over plain HTTP on a LAN
             address. Remove this and use HTTPS before any real release. -->
        <meta-data
            android:name="io.flutter.network-policy"
            android:resource="@xml/network_security_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
